generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  password      String
  role          String    @default("farmer") // farmer, buyer, admin
  status        String    @default("pending") // pending, approved, rejected
  ghanaCardUrl  String    @default("")
  // Identity verification: Ghana Card (GHA-XXXXXXXXX-X) or Passport
  idType        String    @default("ghana-card") // ghana-card | passport
  idNumber      String    @default("") // GHA-123456789-0 or passport number
  passportUrl   String    @default("") // passport photo page (when idType=passport)
  profileImageUrl String  @default("") // user-uploaded avatar (kind=profile, public)
  twoFactorEnabled Boolean @default(true) // OTP on every login (opt-out possible)
  lastNetwork      String   @default("")   // MTN / Telecel / AT detected at registration
  failedLogins     Int      @default(0)    // consecutive failed password attempts
  lockedUntil      DateTime?              // brute-force lockout expiry
  farmer        Farmer?
  buyer         Buyer?
  changeRequests ProfileChangeRequest[]
  wishlist      Wishlist[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Farmer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  region    String
  town      String
  farmSize  Float    @default(0)
  mainCrops String
  listings  Listing[]
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Buyer {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String
  phone        String
  businessType String
  region       String   @default("")
  location     String
  lookingFor   String
  // Default delivery location for checkout (GPS + address)
  deliveryAddress String @default("")
  deliveryLat   Float?
  deliveryLng   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id          String   @id @default(cuid())
  crop        String
  quantity    Int
  unit        String   @default("bags")
  price       Float
  grade       String   @default("Grade B — Good")
  region      String
  location    String
  farmerId    String
  farmer      Farmer   @relation(fields: [farmerId], references: [id])
  harvestDate String
  notes       String?
  images      String   @default("[]") // JSON array of up to 5 image URLs (public /api/files/<id> URLs)
  status      String   @default("available") // available, reserved, sold
  postedDate  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Price {
  id        String   @id @default(cuid())
  crop      String
  market    String
  region    String
  lowPrice  Float
  highPrice Float
  trend     String   @default("stable") // up, down, stable
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id])
  buyerId   String
  buyerName String
  rating    Int      // 1-5 stars
  comment   String
  createdAt DateTime @default(now())
}

model Order {
  id              String    @id @default(cuid())
  listingId       String
  crop            String
  quantity        Int
  unitPrice       Float
  totalAmount     Float     // quantity * unitPrice
  commissionRate   Float    @default(0.05) // 5% admin commission
  hubtelFeeRate   Float    @default(0.015) // 1.5% Hubtel fee
  commissionAmount Float
  hubtelFeeAmount Float     // 1.5% of total
  farmerPayout    Float     // totalAmount - commission - hubtelFee (88.5%)
  farmerId        String
  farmerName      String
  farmerPhone     String
  buyerId         String
  buyerName       String
  buyerPhone      String
  status          String    @default("pending") // pending → paid → delivered → released → cancelled
  paystackRef     String?   // Paystack transaction reference
  paymentProvider String    @default("paystack") // paystack, hubtel, manual
  hubtelTxId      String?   // legacy Hubtel transaction ID
  paymentMethod   String?   // momo, card
  adminNote       String?
  deliveredAt     DateTime? // when buyer confirmed receipt
  refundRequestedAt DateTime? // when buyer requested a refund
  refundedAt      DateTime? // when admin sent the refund (2-3 day window)
  autoReleased    Boolean   @default(false) // set when 48h auto-release cron fires

  // ---- Delivery location (buyer GPS at checkout) ----
  deliveryAddress String? // free-text landmark/address
  deliveryLat     Float?   // GPS latitude
  deliveryLng     Float?   // GPS longitude

  // ---- Refund case (2-3 day window after delivery confirmation) ----
  refundReason      String?   // buyer's stated reason
  refundAmount      Float?    // what the buyer actually receives (damage-adjusted)
  farmerComplaint   String?   // farmer's claim of buyer-side damage
  farmerComplaintAt DateTime? // when the farmer filed it
  damageDeduction   Float?    // amount subtracted for measured damage
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([farmerId])
  @@index([buyerId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   // bcrypt hash of the 6-digit code
  purpose   String   @default("login") // login, reset, admin_login, admin_action, admin_session
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([purpose, createdAt])
}

// Farmer-added products. When a farmer lists a crop that isn't in the built-in
// ghanaCrops list, it's saved here so it appears in suggestions for everyone.
model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  createdBy String?  // farmer's userId
  createdAt DateTime @default(now())
}

// User reports/complaints — scams, payment issues, fake listings, hacked
// accounts etc. Anyone (even not logged in) can file one; the admin gets an
// SMS and manages them in the admin panel.
model Report {
  id            String   @id @default(cuid())
  category      String   @default("other") // scam | payment | fake-listing | behavior | hacked-account | other
  message       String
  reporterId    String?  // null = anonymous
  reporterName  String   @default("Anonymous")
  reporterPhone String   @default("")
  listingUrl    String   @default("")
  status        String   @default("new") // new | reviewing | resolved
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

// ===== Buyer wishlist =====
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  crop      String   // denormalized so the page renders even if listing is deleted
  createdAt DateTime @default(now())

  @@unique([userId, listingId]) // one wishlist row per buyer per listing
  @@index([userId])
}

// ===== In-app notifications (buyers + farmers + admin) =====
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // order | payment | refund | system | approval | price
  title     String
  body      String
  link      String   @default("") // internal path to open, e.g. /orders
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// Admin-managed site content (hero image etc). Key-value store; the value
// holds a /api/files/<id> URL for images.
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Pending account changes (name or password) that the ADMIN must approve
// before they take effect. Users request a change; the request sits here
// until approved/rejected in the admin panel, then the live values update.
model ProfileChangeRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  kind        String   // "name" | "password"
  newName     String?  // when kind = "name"
  newPassHash String?  // bcrypt hash, when kind = "password"
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
}

// Uploaded files (Ghana Cards, listing photos).
// Stored as BYTEA in Postgres so uploads survive Vercel's read-only filesystem.
// kind = "ghana-card" (private — only the admin + owner can view)
//        | "listing" (public — shown on the market page)
model StoredFile {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  size        Int
  kind        String   @default("listing") // ghana-card | listing
  ownerId     String?  // uploader's userId (null for orphaned/legacy files)
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([kind])
}

// Admin email-verification codes — sent to ADMIN_EMAIL (dicksonapam@gmail.com).
// Separate from OtpCode so admin codes never collide with SMS codes, and so
// admin login attempts can be locked out independently of phone OTP.
model AdminOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    // bcrypt hash of the 8-digit code
  purpose    String    @default("admin_login") // admin_login | admin_action
  expiresAt  DateTime
  used       Boolean   @default(false)
  attempts   Int       @default(0)
  ip         String    @default("")
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   // admin userId
  actorName String
  action    String   // e.g. order.released, user.approved, admin.login
  targetId  String?  // order/user id
  details   String?  // JSON or note
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
// Web Push subscription (admin offline notifications — PWA)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // push service URL — one row per browser/device
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
