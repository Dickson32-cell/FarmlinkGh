# Hubtel Payment API Keys - Get these from https://hubtel.com/business
# Dashboard → Settings → API & Developers
HUBTEL_CLIENT_ID=your_client_id_here
HUBTEL_CLIENT_SECRET=your_client_secret_here
HUBTEL_MERCHANT_NO=your_merchant_account_number

# Admin MoMo number (fallback when Hubtel is not configured)
ADMIN_MOMO=0244000000

# Commission rates
COMMISSION_RATE=0.10
HUBTEL_FEE_RATE=0.015

# Existing
JWT_SECRET="farmlink-ghana-jwt-secret-2026"
# Paystack Payment API (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_FEE_RATE=0.0195
NEXT_PUBLIC_APP_URL=http://localhost:3001
